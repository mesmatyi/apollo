#
# Declarative target specs generated from Bazel BUILD files
# (tools/ros2/bazel2cmake.py -> modules/**/BUILD.cmake) and the machinery that
# turns them into CMake targets:
#
#   1. declaration  apollo_bazel_package() / apollo_target() only record specs
#                   in global properties; nothing is created yet.
#   2. resolution   apollo_resolve_targets() maps every Bazel label to a CMake
#                   target, an external find_package() result or a proto
#                   library, and transitively marks targets whose
#                   dependencies are unavailable as skipped (with the root
#                   cause).
#   3. creation     apollo_create_targets() creates libraries, executables,
#                   tests and install rules for every available target
#                   (optionally only those under APOLLO_BUILD_ONLY and what
#                   they need).
#
# Global properties:  APOLLO_TARGETS, "APOLLO_LABEL::<label>" -> target,
#                     "APOLLO_T::<target>::<FIELD>".
include_guard(GLOBAL)

set(_APOLLO_SINGLE_FIELDS OUTPUT_NAME PLUGIN_DESCRIPTION BROKEN)
set(_APOLLO_MULTI_FIELDS ALIASES SRCS HDRS DEPS DEFINES LOCAL_DEFINES COPTS
    LINKOPTS INCLUDES DATA COMPONENTS FLAGS)
set(_APOLLO_CC_KINDS cc_library component plugin cc_shared cc_binary cc_test qt_library)
set(_APOLLO_LOADABLE_KINDS component plugin cc_shared)
set(_APOLLO_COMPILED_EXT_REGEX "\\.(cc|cpp|cxx|c|C|S)$")

macro(_apollo_get var t field)
  get_property(${var} GLOBAL PROPERTY "APOLLO_T::${t}::${field}")
endmacro()

macro(_apollo_set t field)
  set_property(GLOBAL PROPERTY "APOLLO_T::${t}::${field}" "${ARGN}")
endmacro()

###############################################################################
# 1. declaration
###############################################################################
function(apollo_bazel_package pkg)
  set_property(GLOBAL PROPERTY APOLLO_CURRENT_PACKAGE "${pkg}")
  set_property(GLOBAL APPEND PROPERTY APOLLO_PACKAGES "${pkg}")
endfunction()

function(apollo_target kind name)
  cmake_parse_arguments(PARSE_ARGV 2 A "" "TARGET;${_APOLLO_SINGLE_FIELDS}"
                        "${_APOLLO_MULTI_FIELDS}")
  get_property(pkg GLOBAL PROPERTY APOLLO_CURRENT_PACKAGE)
  set(t "${A_TARGET}")
  if(NOT t)
    message(FATAL_ERROR "apollo_target(${kind} ${name}) in ${pkg} has no TARGET")
  endif()
  set_property(GLOBAL APPEND PROPERTY APOLLO_TARGETS "${t}")
  _apollo_set(${t} KIND ${kind})
  _apollo_set(${t} NAME "${name}")
  _apollo_set(${t} PKG "${pkg}")
  foreach(f IN LISTS _APOLLO_SINGLE_FIELDS _APOLLO_MULTI_FIELDS)
    _apollo_set(${t} ${f} "${A_${f}}")
  endforeach()
  foreach(n IN ITEMS "${name}" ${A_ALIASES})
    set_property(GLOBAL PROPERTY "APOLLO_LABEL:://${pkg}:${n}" "${t}")
  endforeach()
endfunction()

# External / third-party label mapping:
#   apollo_external(<label> <cmake targets or link items...>)
#   apollo_external(<label> MISSING "<reason>")
# <label> may be a full label (@repo//pkg:name, //third_party/x:y) or a whole
# repository (@repo).
function(apollo_external label)
  set_property(GLOBAL PROPERTY "APOLLO_EXT::${label}" "${ARGN}")
  set_property(GLOBAL PROPERTY "APOLLO_EXT_DEFINED::${label}" TRUE)
endfunction()

###############################################################################
# helpers
###############################################################################
# Filters `cond1,!cond2?value` entries using the APOLLO_WITH_<cond> variables.
function(_apollo_filter out)
  set(res)
  foreach(e IN LISTS ARGN)
    if(e MATCHES "^(!?[a-z0-9_]+(,!?[a-z0-9_]+)*)\\?(.*)$")
      set(val "${CMAKE_MATCH_3}")
      string(REPLACE "," ";" conds "${CMAKE_MATCH_1}")
      set(ok TRUE)
      foreach(c IN LISTS conds)
        if(c MATCHES "^!(.*)$")
          if(APOLLO_WITH_${CMAKE_MATCH_1})
            set(ok FALSE)
          endif()
        elseif(NOT APOLLO_WITH_${c})
          set(ok FALSE)
        endif()
      endforeach()
      if(ok)
        list(APPEND res "${val}")
      endif()
    else()
      list(APPEND res "${e}")
    endif()
  endforeach()
  set(${out} "${res}" PARENT_SCOPE)
endfunction()

# Package-relative file or //pkg:file reference -> absolute path.
function(_apollo_file_path out pkg file)
  if(file MATCHES "^//([^:]*):(.*)$")
    set(${out} "${APOLLO_SOURCE_ROOT}/${CMAKE_MATCH_1}/${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${out} "${APOLLO_SOURCE_ROOT}/${pkg}/${file}" PARENT_SCOPE)
  endif()
endfunction()

# Same, relative to the repository root.
function(_apollo_repo_path out pkg file)
  if(file MATCHES "^//([^:]*):(.*)$")
    set(${out} "${CMAKE_MATCH_1}/${CMAKE_MATCH_2}" PARENT_SCOPE)
  else()
    set(${out} "${pkg}/${file}" PARENT_SCOPE)
  endif()
endfunction()

# file(WRITE) that keeps the timestamp when the content is unchanged
function(_apollo_write_if_different path content)
  if(EXISTS "${path}")
    file(READ "${path}" old)
    if(old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()

# modules/<module>/... -> <module>; also the second level (<module>__<sub>)
function(_apollo_module_of out pkg)
  string(REPLACE "/" ";" parts "${pkg}")
  list(LENGTH parts n)
  if(n GREATER 1)
    list(GET parts 1 m)
  else()
    set(m "${pkg}")
  endif()
  set(${out} "${m}" PARENT_SCOPE)
endfunction()

function(_apollo_submodule_of out pkg)
  string(REPLACE "/" ";" parts "${pkg}")
  list(LENGTH parts n)
  if(n GREATER 2)
    list(GET parts 1 m)
    list(GET parts 2 sub)
    set(${out} "${m}__${sub}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

function(_apollo_mark_skip t why)
  _apollo_set(${t} STATUS SKIP)
  _apollo_set(${t} WHY "${why}")
endfunction()

# Resolves a library linkopt such as -lfoo; sets out to the link item or
# to an empty string (and why) when the library cannot be found.
function(_apollo_resolve_linkopt out why opt)
  set(${why} "" PARENT_SCOPE)
  if(opt MATCHES "^-l(.+)$")
    set(lib "${CMAKE_MATCH_1}")
    if(lib MATCHES "^(m|dl|rt|pthread|gomp|atomic|stdc\\+\\+fs)$")
      set(${out} "${opt}" PARENT_SCOPE)
      return()
    endif()
    string(MAKE_C_IDENTIFIER "${lib}" libid)
    find_library(APOLLO_LINKOPT_LIB_${libid} NAMES ${lib})
    if(APOLLO_LINKOPT_LIB_${libid})
      set(${out} "${APOLLO_LINKOPT_LIB_${libid}}" PARENT_SCOPE)
    else()
      set(${out} "" PARENT_SCOPE)
      set(${why} "missing library ${opt}" PARENT_SCOPE)
    endif()
  elseif(opt MATCHES "^-L")
    set(${out} "" PARENT_SCOPE)  # search paths of the Bazel sysroot: ignored
  else()
    set(${out} "${opt}" PARENT_SCOPE)
  endif()
endfunction()

###############################################################################
# 2. resolution
###############################################################################
# Resolves one dependency label. Sets <out_items> to the CMake link items,
# <out_why> to the reason when unavailable (empty when available).
function(_apollo_resolve_dep out_items out_why label)
  set(${out_why} "" PARENT_SCOPE)
  set(${out_items} "" PARENT_SCOPE)
  # explicit external / third_party mapping (exact label, then repository)
  set(key "")
  get_property(defined GLOBAL PROPERTY "APOLLO_EXT_DEFINED::${label}")
  if(defined)
    set(key "${label}")
  elseif(label MATCHES "^(@[^/]+)//")
    get_property(defined GLOBAL PROPERTY "APOLLO_EXT_DEFINED::${CMAKE_MATCH_1}")
    if(defined)
      set(key "${CMAKE_MATCH_1}")
    endif()
  endif()
  if(key)
    get_property(items GLOBAL PROPERTY "APOLLO_EXT::${key}")
    list(GET items 0 first)
    if(first STREQUAL "MISSING")
      list(LENGTH items n)
      if(n GREATER 1)
        list(GET items 1 reason)
      else()
        set(reason "not available")
      endif()
      set(${out_why} "${key}: ${reason}" PARENT_SCOPE)
    else()
      set(${out_items} "${items}" PARENT_SCOPE)
    endif()
    return()
  endif()
  if(label MATCHES "^//cyber(/|:)")
    if(TARGET cyber::cyber)
      set(${out_items} cyber::cyber PARENT_SCOPE)
    else()
      set(${out_why} "package cyber not found" PARENT_SCOPE)
    endif()
    return()
  endif()
  if(label MATCHES "^@")
    set(${out_why} "unknown external ${label}" PARENT_SCOPE)
    return()
  endif()
  get_property(dep GLOBAL PROPERTY "APOLLO_LABEL::${label}")
  if(NOT dep)
    set(${out_why} "unknown label ${label}" PARENT_SCOPE)
    return()
  endif()
  _apollo_check(${dep})
  _apollo_get(status ${dep} STATUS)
  if(status STREQUAL "SKIP")
    _apollo_get(why ${dep} WHY)
    set(${out_why} "${why}" PARENT_SCOPE)
    return()
  endif()
  _apollo_get(kind ${dep} KIND)
  if(kind STREQUAL "proto")
    _apollo_get(items ${dep} LINK)
    set(${out_items} "${items}" PARENT_SCOPE)
  elseif(kind STREQUAL "filegroup" OR kind MATCHES "^py_")
    # data dependency: nothing to link
  elseif(kind STREQUAL "cc_binary" OR kind STREQUAL "cc_test")
    # binaries are not linkable
  else()
    set(${out_items} "${dep}" PARENT_SCOPE)
  endif()
endfunction()

function(_apollo_check t)
  _apollo_get(status ${t} STATUS)
  if(status)
    return()  # done, or VISITING (cycle: Bazel graphs are acyclic anyway)
  endif()
  _apollo_set(${t} STATUS VISITING)
  _apollo_get(kind ${t} KIND)
  _apollo_get(pkg ${t} PKG)
  _apollo_get(broken ${t} BROKEN)
  if(broken)
    _apollo_mark_skip(${t} "${broken}")
    return()
  endif()

  if(kind STREQUAL "proto")
    _apollo_get(srcs ${t} SRCS)
    _apollo_filter(srcs ${srcs})
    set(libs)
    foreach(s IN LISTS srcs)
      _apollo_repo_path(p "${pkg}" "${s}")
      get_property(lib GLOBAL PROPERTY "APOLLO_PROTO_LIB::${p}")
      if(NOT lib)
        _apollo_mark_skip(${t} "proto file ${p} is not compiled")
        return()
      endif()
      list(APPEND libs ${lib})
    endforeach()
    if(NOT srcs)
      # cc_proto_library / py_proto_library: forward the proto deps
      _apollo_get(deps ${t} DEPS)
      _apollo_filter(deps ${deps})
      foreach(d IN LISTS deps)
        _apollo_resolve_dep(items why "${d}")
        if(why)
          _apollo_mark_skip(${t} "${why}")
          return()
        endif()
        list(APPEND libs ${items})
      endforeach()
    endif()
    list(REMOVE_DUPLICATES libs)
    _apollo_set(${t} LINK ${libs})
    _apollo_set(${t} STATUS OK)
    return()
  endif()

  if(kind STREQUAL "filegroup" OR kind MATCHES "^py_")
    _apollo_set(${t} STATUS OK)
    return()
  endif()

  if(kind STREQUAL "qt_library" AND NOT TARGET Qt5::Widgets)
    _apollo_mark_skip(${t} "Qt5 not found")
    return()
  endif()

  if(kind STREQUAL "cc_test" AND NOT APOLLO_BUILD_TESTS)
    _apollo_mark_skip(${t} "tests disabled (APOLLO_BUILD_TESTS=OFF)")
    return()
  endif()
  if(kind STREQUAL "cc_test" AND NOT TARGET GTest::gtest)
    _apollo_mark_skip(${t} "GTest not found")
    return()
  endif()

  _apollo_get(deps ${t} DEPS)
  _apollo_filter(deps ${deps})
  set(link)
  foreach(d IN LISTS deps)
    if(kind STREQUAL "cc_test" AND d MATCHES "^@com_google_googletest//:gtest(_main)?$")
      continue()  # linked explicitly in _apollo_create_cc
    endif()
    _apollo_resolve_dep(items why "${d}")
    if(why)
      _apollo_mark_skip(${t} "${why}")
      _apollo_set(${t} VIA "${d}")
      return()
    endif()
    list(APPEND link ${items})
  endforeach()
  _apollo_get(linkopts ${t} LINKOPTS)
  _apollo_filter(linkopts ${linkopts})
  set(lopts)
  foreach(o IN LISTS linkopts)
    _apollo_resolve_linkopt(item why "${o}")
    if(why)
      _apollo_mark_skip(${t} "${why}")
      return()
    endif()
    if(item)
      list(APPEND lopts "${item}")
    endif()
  endforeach()
  if(link)
    list(REMOVE_DUPLICATES link)
  endif()
  _apollo_set(${t} LINK ${link})
  _apollo_set(${t} LINKOPTS_RESOLVED ${lopts})
  _apollo_set(${t} STATUS OK)
endfunction()

function(apollo_resolve_targets)
  get_property(targets GLOBAL PROPERTY APOLLO_TARGETS)
  foreach(t IN LISTS targets)
    _apollo_check(${t})
  endforeach()
endfunction()

###############################################################################
# 3. creation
###############################################################################
function(_apollo_is_loadable out t)
  _apollo_get(kind ${t} KIND)
  _apollo_get(flags ${t} FLAGS)
  if(kind IN_LIST _APOLLO_LOADABLE_KINDS OR "LOADABLE" IN_LIST flags)
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

# Marks the targets that must be created: everything available, or with
# APOLLO_BUILD_ONLY the targets under those package prefixes plus their deps.
function(_apollo_mark_needed t)
  _apollo_get(needed ${t} NEEDED)
  if(needed)
    return()
  endif()
  _apollo_set(${t} NEEDED TRUE)
  _apollo_get(link ${t} LINK)
  foreach(d IN LISTS link)
    get_property(is_spec GLOBAL PROPERTY "APOLLO_T::${d}::KIND")
    if(is_spec)
      _apollo_mark_needed(${d})
    endif()
  endforeach()
endfunction()

function(_apollo_in_build_only out pkg)
  if(NOT APOLLO_BUILD_ONLY)
    set(${out} TRUE PARENT_SCOPE)
    return()
  endif()
  foreach(prefix IN LISTS APOLLO_BUILD_ONLY)
    string(REGEX REPLACE "/+$" "" prefix "${prefix}")
    if(pkg STREQUAL prefix OR pkg MATCHES "^${prefix}/")
      set(${out} TRUE PARENT_SCOPE)
      return()
    endif()
  endforeach()
  set(${out} FALSE PARENT_SCOPE)
endfunction()

# Install directories (relative to the prefix) of the libraries a target
# needs at runtime that are not in lib/ (component/plugin/loadable libs).
function(_apollo_loadable_dirs out t)
  _apollo_get(cached ${t} LDIRS_DONE)
  if(cached)
    _apollo_get(dirs ${t} LDIRS)
    set(${out} "${dirs}" PARENT_SCOPE)
    return()
  endif()
  _apollo_set(${t} LDIRS_DONE TRUE)
  set(dirs)
  _apollo_get(link ${t} LINK)
  foreach(d IN LISTS link)
    get_property(is_spec GLOBAL PROPERTY "APOLLO_T::${d}::KIND")
    if(NOT is_spec)
      continue()
    endif()
    _apollo_is_loadable(loadable ${d})
    if(loadable)
      _apollo_get(dpkg ${d} PKG)
      list(APPEND dirs "lib/apollo/${dpkg}")
    endif()
    _apollo_loadable_dirs(sub ${d})
    list(APPEND dirs ${sub})
  endforeach()
  if(dirs)
    list(REMOVE_DUPLICATES dirs)
  endif()
  _apollo_set(${t} LDIRS ${dirs})
  set(${out} "${dirs}" PARENT_SCOPE)
endfunction()

function(_apollo_set_rpath t install_dir)
  set(rpath)
  file(RELATIVE_PATH to_lib "/${install_dir}" "/lib")
  if(to_lib STREQUAL "")
    list(APPEND rpath "$ORIGIN")
  else()
    list(APPEND rpath "$ORIGIN/${to_lib}")
  endif()
  _apollo_loadable_dirs(dirs ${t})
  foreach(d IN LISTS dirs)
    file(RELATIVE_PATH rel "/${install_dir}" "/${d}")
    if(rel STREQUAL "")
      list(APPEND rpath "$ORIGIN")
    else()
      list(APPEND rpath "$ORIGIN/${rel}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES rpath)
  set_target_properties(${t} PROPERTIES INSTALL_RPATH "${rpath}")
endfunction()

function(_apollo_create_cc t)
  _apollo_get(kind ${t} KIND)
  _apollo_get(pkg ${t} PKG)
  _apollo_get(name ${t} NAME)
  _apollo_get(output_name ${t} OUTPUT_NAME)
  foreach(f SRCS HDRS DEFINES LOCAL_DEFINES COPTS INCLUDES)
    _apollo_get(v ${t} ${f})
    _apollo_filter(${f} ${v})
  endforeach()
  _apollo_get(link ${t} LINK)
  _apollo_get(lopts ${t} LINKOPTS_RESOLVED)
  _apollo_is_loadable(loadable ${t})

  set(sources)
  set(compiled FALSE)
  foreach(s IN LISTS SRCS HDRS)
    _apollo_file_path(p "${pkg}" "${s}")
    list(APPEND sources "${p}")
    if(s MATCHES "${_APOLLO_COMPILED_EXT_REGEX}")
      set(compiled TRUE)
    endif()
  endforeach()

  set(interface FALSE)
  if(kind STREQUAL "cc_binary")
    if(NOT compiled)
      list(APPEND sources "${APOLLO_EMPTY_SOURCE}")  # main() comes from a dep
    endif()
    add_executable(${t} ${sources})
    set_target_properties(${t} PROPERTIES
      OUTPUT_NAME "${name}"
      RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin/${pkg}")
    install(TARGETS ${t} RUNTIME DESTINATION lib/${PROJECT_NAME})
    _apollo_set_rpath(${t} "lib/${PROJECT_NAME}")
  elseif(kind STREQUAL "cc_test")
    # Plain executables + add_test() instead of ament_add_gtest(): every test
    # and every library that links @com_google_googletest then use the same
    # gtest (GTest::gtest from find_package(GTest)), and the tests get the
    # Apollo runtime environment (see APOLLO_TEST_ENVIRONMENT).
    if(NOT compiled)
      list(APPEND sources "${APOLLO_EMPTY_SOURCE}")
    endif()
    add_executable(${t} ${sources})
    set_target_properties(${t} PROPERTIES
      OUTPUT_NAME "${name}"
      RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/tests/${pkg}")
    _apollo_get(deps ${t} DEPS)
    if("@com_google_googletest//:gtest_main" IN_LIST deps)
      target_link_libraries(${t} PRIVATE GTest::gtest_main GTest::gtest)
    else()
      target_link_libraries(${t} PRIVATE GTest::gtest)
    endif()
    _apollo_module_of(module "${pkg}")
    add_test(NAME ${t}
      COMMAND ${t} "--gtest_output=xml:${CMAKE_BINARY_DIR}/test_results/${PROJECT_NAME}/${t}.gtest.xml"
      WORKING_DIRECTORY "${APOLLO_SOURCE_ROOT}")
    set_tests_properties(${t} PROPERTIES
      LABELS "${module}"
      TIMEOUT ${APOLLO_TEST_TIMEOUT}
      ENVIRONMENT "${APOLLO_TEST_ENVIRONMENT}")
  elseif(kind MATCHES "^(cc|qt)_library$" AND NOT compiled AND NOT loadable)
    add_library(${t} INTERFACE)
    set(interface TRUE)
  else()
    if(NOT compiled)
      list(APPEND sources "${APOLLO_EMPTY_SOURCE}")
    endif()
    add_library(${t} SHARED ${sources})
    if(loadable)
      set_target_properties(${t} PROPERTIES
        PREFIX "" SUFFIX "" OUTPUT_NAME "${output_name}"
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib/apollo/${pkg}")
      install(TARGETS ${t} LIBRARY DESTINATION lib/apollo/${pkg})
      _apollo_set_rpath(${t} "lib/apollo/${pkg}")
    else()
      set_target_properties(${t} PROPERTIES
        OUTPUT_NAME "apollo_${t}"
        LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/lib")
      install(TARGETS ${t} LIBRARY DESTINATION lib)
      _apollo_set_rpath(${t} "lib")
    endif()
  endif()

  if(kind STREQUAL "qt_library")
    _apollo_get(data ${t} DATA)
    _apollo_filter(data ${data})
    set(ui_dirs)
    foreach(d IN LISTS data)
      _apollo_file_path(p "${pkg}" "${d}")
      target_sources(${t} PRIVATE "${p}")
      if(p MATCHES "\\.ui$")
        get_filename_component(ui_dir "${p}" DIRECTORY)
        list(APPEND ui_dirs "${ui_dir}")
      endif()
    endforeach()
    set_target_properties(${t} PROPERTIES AUTOMOC ON AUTOUIC ON AUTORCC ON
                                          AUTOUIC_SEARCH_PATHS "${ui_dirs}")
  endif()
  if(interface)
    set(vis INTERFACE)
  else()
    set(vis PUBLIC)
  endif()
  target_include_directories(${t} ${vis} "$<BUILD_INTERFACE:${APOLLO_SOURCE_ROOT}>")
  foreach(inc IN LISTS INCLUDES)
    target_include_directories(${t} ${vis} "$<BUILD_INTERFACE:${APOLLO_SOURCE_ROOT}/${pkg}/${inc}>")
  endforeach()
  if(DEFINES)
    target_compile_definitions(${t} ${vis} ${DEFINES})
  endif()
  if(NOT interface)
    if(APOLLO_TARGET_COMPILE_OPTIONS)
      target_compile_options(${t} PRIVATE ${APOLLO_TARGET_COMPILE_OPTIONS})
    endif()
    if(LOCAL_DEFINES)
      target_compile_definitions(${t} PRIVATE ${LOCAL_DEFINES})
    endif()
    if(COPTS)
      target_compile_options(${t} PRIVATE ${COPTS})
      if("-fopenmp" IN_LIST COPTS)
        target_link_options(${t} PUBLIC -fopenmp)
      endif()
    endif()
    if(NOT kind MATCHES "^(cc|qt)_library$" OR loadable)
      # Bazel links these with alwayslink semantics: keep every dependency
      # (static registration of factories/components) even if unreferenced.
      target_link_options(${t} PRIVATE "LINKER:--no-as-needed")
    endif()
  endif()
  if(link)
    target_link_libraries(${t} ${vis} ${link})
  endif()
  if(lopts)
    target_link_libraries(${t} ${vis} ${lopts})
  endif()
  _apollo_set(${t} CREATED TRUE)
endfunction()

function(_apollo_install_files t)
  _apollo_get(pkg ${t} PKG)
  _apollo_get(srcs ${t} SRCS)
  _apollo_filter(srcs ${srcs})
  foreach(s IN LISTS srcs)
    _apollo_file_path(abs "${pkg}" "${s}")
    if(NOT EXISTS "${abs}" OR IS_DIRECTORY "${abs}")
      continue()
    endif()
    _apollo_repo_path(rel "${pkg}" "${s}")
    get_filename_component(dir "${rel}" DIRECTORY)
    set_property(GLOBAL APPEND PROPERTY "APOLLO_DATA_DIR::${dir}" "${abs}")
    set_property(GLOBAL APPEND PROPERTY APOLLO_DATA_DIRS "${dir}")
  endforeach()
endfunction()

function(_apollo_install_python t)
  _apollo_get(pkg ${t} PKG)
  foreach(f SRCS)
    _apollo_get(srcs ${t} ${f})
    _apollo_filter(srcs ${srcs})
    foreach(s IN LISTS srcs)
      if(NOT s MATCHES "\\.py$")
        continue()
      endif()
      _apollo_file_path(abs "${pkg}" "${s}")
      _apollo_repo_path(rel "${pkg}" "${s}")
      get_filename_component(dir "${rel}" DIRECTORY)
      install(FILES "${abs}" DESTINATION "${PYTHON_INSTALL_DIR}/${dir}")
    endforeach()
  endforeach()
  # py_binary: the main script also becomes `ros2 run apollo <name>`
  _apollo_get(kind ${t} KIND)
  if(kind STREQUAL "py_binary")
    _apollo_get(name ${t} NAME)
    _apollo_get(flags ${t} FLAGS)
    set(main "")
    foreach(f IN LISTS flags)
      if(f MATCHES "^MAIN=(.*)$")
        set(main "${CMAKE_MATCH_1}")
      endif()
    endforeach()
    if(NOT main)
      if("${name}.py" IN_LIST srcs)
        set(main "${name}.py")
      else()
        list(LENGTH srcs n)
        if(n EQUAL 1)
          set(main "${srcs}")
        endif()
      endif()
    endif()
    if(main MATCHES "^:(.*)$")
      set(main "${CMAKE_MATCH_1}")
    endif()
    if(main)
      _apollo_file_path(abs "${pkg}" "${main}")
      if(EXISTS "${abs}")
        install(PROGRAMS "${abs}" DESTINATION lib/${PROJECT_NAME} RENAME "${name}")
      endif()
    endif()
  endif()
endfunction()

function(_apollo_create_plugin_files t)
  _apollo_get(pkg ${t} PKG)
  _apollo_get(desc ${t} PLUGIN_DESCRIPTION)
  _apollo_get(output_name ${t} OUTPUT_NAME)
  if(NOT desc MATCHES "^//([^:]*):(.*)$")
    return()
  endif()
  set(desc_pkg "${CMAKE_MATCH_1}")
  set(desc_file "${CMAKE_MATCH_2}")
  get_filename_component(desc_dir "${desc_pkg}/${desc_file}" DIRECTORY)
  install(FILES "${APOLLO_SOURCE_ROOT}/${desc_pkg}/${desc_file}"
          DESTINATION "share/${PROJECT_NAME}/${desc_dir}")
  string(REPLACE "/" "__" index_name "${pkg}")
  set(index_file "${CMAKE_BINARY_DIR}/cyber_plugin_index/${index_name}__${output_name}")
  _apollo_write_if_different("${index_file}" "${desc_pkg}/${desc_file}")
  install(FILES "${index_file}" DESTINATION share/cyber_plugin_index)
endfunction()

function(apollo_create_targets)
  get_property(targets GLOBAL PROPERTY APOLLO_TARGETS)
  # which targets to create
  foreach(t IN LISTS targets)
    _apollo_get(status ${t} STATUS)
    _apollo_get(pkg ${t} PKG)
    _apollo_in_build_only(inside "${pkg}")
    if(status STREQUAL "OK" AND inside)
      _apollo_mark_needed(${t})
    endif()
  endforeach()

  # Packages whose C++ code is entirely unavailable here (e.g. GPU-only
  # perception, libtorch prediction) do not install their data either: that
  # is mostly model files.
  foreach(t IN LISTS targets)
    _apollo_get(kind ${t} KIND)
    if(kind IN_LIST _APOLLO_CC_KINDS AND NOT kind STREQUAL "cc_test")
      _apollo_get(pkg ${t} PKG)
      _apollo_get(status ${t} STATUS)
      set_property(GLOBAL PROPERTY "APOLLO_PKG_HAS_CC::${pkg}" TRUE)
      if(status STREQUAL "OK")
        set_property(GLOBAL PROPERTY "APOLLO_PKG_CC_OK::${pkg}" TRUE)
      endif()
    endif()
  endforeach()

  set(component_lines)
  foreach(t IN LISTS targets)
    _apollo_get(needed ${t} NEEDED)
    if(NOT needed)
      continue()
    endif()
    _apollo_get(kind ${t} KIND)
    _apollo_get(pkg ${t} PKG)
    if(kind IN_LIST _APOLLO_CC_KINDS)
      _apollo_create_cc(${t})
      _apollo_get(created ${t} CREATED)
      if(created)
        set_property(GLOBAL APPEND PROPERTY APOLLO_CREATED_TARGETS ${t})
        _apollo_module_of(module "${pkg}")
        _apollo_submodule_of(sub "${pkg}")
        if(kind STREQUAL "cc_test")
          set(group tests)
        else()
          set(group module)
        endif()
        set_property(GLOBAL APPEND PROPERTY "APOLLO_GROUP::${group}::${module}" ${t})
        set_property(GLOBAL APPEND PROPERTY "APOLLO_GROUPS::${group}" ${module})
        if(sub)
          set_property(GLOBAL APPEND PROPERTY "APOLLO_GROUP::${group}::${sub}" ${t})
          set_property(GLOBAL APPEND PROPERTY "APOLLO_GROUPS::${group}" ${sub})
        endif()
        _apollo_is_loadable(loadable ${t})
        _apollo_get(components ${t} COMPONENTS)
        _apollo_get(output_name ${t} OUTPUT_NAME)
        if(loadable)
          foreach(c IN LISTS components)
            list(APPEND component_lines "${c}|lib/apollo/${pkg}/${output_name}")
          endforeach()
        endif()
        if(kind STREQUAL "plugin")
          _apollo_create_plugin_files(${t})
        endif()
      endif()
    elseif(kind STREQUAL "filegroup")
      _apollo_get(name ${t} NAME)
      if(NOT APOLLO_BUILD_TESTS AND name MATCHES "test")
        continue()
      endif()
      get_property(has_cc GLOBAL PROPERTY "APOLLO_PKG_HAS_CC::${pkg}")
      get_property(cc_ok GLOBAL PROPERTY "APOLLO_PKG_CC_OK::${pkg}")
      if(has_cc AND NOT cc_ok)
        continue()
      endif()
      _apollo_install_files(${t})
    elseif(kind MATCHES "^py_(library|binary)$")
      _apollo_install_python(${t})
    endif()
  endforeach()

  # Manifest of the created targets (target|kind|package|name|file), used by
  # status reports: a target whose file exists has been built.
  get_property(created_all GLOBAL PROPERTY APOLLO_CREATED_TARGETS)
  set(manifest "")
  foreach(t IN LISTS created_all)
    _apollo_get(kind ${t} KIND)
    _apollo_get(pkg ${t} PKG)
    _apollo_get(name ${t} NAME)
    get_target_property(type ${t} TYPE)
    if(type STREQUAL "INTERFACE_LIBRARY")
      set(f "-")
    else()
      set(f "$<TARGET_FILE:${t}>")
    endif()
    string(APPEND manifest "${t}|${kind}|${pkg}|${name}|${f}\n")
  endforeach()
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/apollo_targets_manifest.txt" CONTENT "${manifest}")

  # Aggregate targets: apollo_module_<module> builds every available
  # library/component/plugin/binary of modules/<module> (and
  # apollo_module_<module>__<subdir> those of modules/<module>/<subdir>);
  # apollo_tests_<module>[__<subdir>] builds the tests.
  foreach(group module tests)
    get_property(names GLOBAL PROPERTY "APOLLO_GROUPS::${group}")
    if(names)
      list(REMOVE_DUPLICATES names)
    endif()
    foreach(m IN LISTS names)
      get_property(members GLOBAL PROPERTY "APOLLO_GROUP::${group}::${m}")
      string(MAKE_C_IDENTIFIER "apollo_${group}_${m}" agg)
      add_custom_target(${agg})
      add_dependencies(${agg} ${members})
    endforeach()
  endforeach()

  # data files, grouped per destination directory
  get_property(dirs GLOBAL PROPERTY APOLLO_DATA_DIRS)
  if(dirs)
    list(REMOVE_DUPLICATES dirs)
  endif()
  foreach(dir IN LISTS dirs)
    get_property(files GLOBAL PROPERTY "APOLLO_DATA_DIR::${dir}")
    list(REMOVE_DUPLICATES files)
    install(FILES ${files} DESTINATION "share/${PROJECT_NAME}/${dir}")
  endforeach()

  # ament index: rclcpp_components resource of package apollo
  set(index "${CMAKE_BINARY_DIR}/ament_index/resource_index/rclcpp_components/${PROJECT_NAME}")
  set(content "")
  set(n 0)
  foreach(line IN LISTS component_lines)
    string(REPLACE "|" ";" line "${line}")
    string(APPEND content "${line}\n")
    math(EXPR n "${n} + 1")
  endforeach()
  _apollo_write_if_different("${index}" "${content}")
  if(content)
    install(FILES "${index}" DESTINATION share/ament_index/resource_index/rclcpp_components)
  endif()
  set(APOLLO_COMPONENT_COUNT ${n} PARENT_SCOPE)
endfunction()

###############################################################################
# summary
###############################################################################
function(apollo_print_summary)
  get_property(targets GLOBAL PROPERTY APOLLO_TARGETS)
  set(n_ok 0)
  set(n_skip 0)
  set(n_created 0)
  set(reasons)
  set(report "")
  foreach(t IN LISTS targets)
    _apollo_get(kind ${t} KIND)
    if(NOT kind IN_LIST _APOLLO_CC_KINDS)
      continue()
    endif()
    _apollo_get(status ${t} STATUS)
    _apollo_get(created ${t} CREATED)
    _apollo_get(pkg ${t} PKG)
    _apollo_get(name ${t} NAME)
    if(status STREQUAL "OK")
      math(EXPR n_ok "${n_ok} + 1")
      if(created)
        math(EXPR n_created "${n_created} + 1")
      endif()
    else()
      _apollo_get(why ${t} WHY)
      if(kind STREQUAL "cc_test" AND why MATCHES "^tests disabled")
        continue()
      endif()
      math(EXPR n_skip "${n_skip} + 1")
      string(APPEND report "  SKIP ${kind} //${pkg}:${name}: ${why}\n")
      string(MAKE_C_IDENTIFIER "${why}" wid)
      if(NOT DEFINED _cnt_${wid})
        set(_cnt_${wid} 0)
        list(APPEND reasons "${wid}")
        set(_txt_${wid} "${why}")
      endif()
      math(EXPR _cnt_${wid} "${_cnt_${wid}} + 1")
    endif()
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/apollo_skipped_targets.txt" "${report}")
  message(STATUS "Apollo: ${n_ok} C++ targets available (${n_created} created), "
                 "${n_skip} skipped (details: ${CMAKE_BINARY_DIR}/apollo_skipped_targets.txt)")
  foreach(wid IN LISTS reasons)
    message(STATUS "Apollo:   ${_cnt_${wid}} skipped: ${_txt_${wid}}")
  endforeach()
  message(STATUS "Apollo: ${APOLLO_COMPONENT_COUNT} rclcpp_components entries")
endfunction()
