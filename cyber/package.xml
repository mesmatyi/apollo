<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cyber</name>
  <version>11.0.0</version>
  <description>
    The Apollo Cyber API (Node, Reader, Writer, Component, Service, Timer,
    record, class loader, plugin manager) implemented on ROS 2 / rclcpp.
    Apollo modules keep using the Cyber API; messages travel over ROS 2 as
    apollo_msgs/msg/ProtoMessage and components load into rclcpp_components
    containers.
  </description>
  <maintainer email="apollo-support@baidu.com">Apollo</maintainer>
  <license>Apache-2.0</license>
  <url type="website">https://www.apollo.auto/</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>apollo_msgs</depend>
  <depend>class_loader</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>rcpputils</depend>
  <depend>rosgraph_msgs</depend>
  <depend>rosidl_typesupport_introspection_cpp</depend>
  <depend>protobuf-dev</depend>
  <depend>libgoogle-glog-dev</depend>
  <depend>libgflags-dev</depend>
  <depend>tinyxml2</depend>
  <depend>nlohmann-json-dev</depend>
  <depend>uuid</depend>
  <depend>libncurses-dev</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>python3-protobuf</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
